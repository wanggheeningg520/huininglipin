# ============================================================
# 慧宁甄选礼品商城 环境变量配置
# ============================================================

# ---- 应用 ----
NODE_ENV=development
APP_PORT=3000
APP_NAME=huining-gift-mall

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=hn_app
DB_PASSWORD=app123
DB_DATABASE=huining_mall
DB_POOL_MAX=20
DB_LOGGING=false

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0
REDIS_KEY_PREFIX=hn:

# ---- JWT ----
JWT_SECRET=your-jwt-secret-change-in-prod
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=2h

# ---- 微信小程序 ----
WECHAT_APPID=your-appid
WECHAT_SECRET=your-secret

# ---- 微信支付 v3 ----
WECHAT_PAY_MCHID=your-mch-id
WECHAT_PAY_SERIAL_NO=cert-serial-no
WECHAT_PAY_PRIVATE_KEY_PATH=/app/certs/wechat-pay-private-key.pem
WECHAT_PAY_APIV3=api-v3-key
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/trade/pay/callback

# ---- OSS（阿里云）----
OSS_REGION=oss-cn-beijing
OSS_BUCKET=huining-mall
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_CDN_DOMAIN=https://cdn.your-domain.com

# ---- 物流查询 ----
LOGISTICS_PROVIDER=kuaidi100
KUAIDI100_CUSTOMER=your-customer
KUAIDI100_KEY=your-key
SF_APP_ID=your-sf-app-id
SF_APP_KEY=your-sf-app-key
LOGISTICS_CACHE_TTL=1800

# ---- 业务参数 ----
PAY_TIMEOUT_MINUTES=30
AFTER_SALE_DAYS=7
ADDRESS_LIMIT=20
CART_QTY_LIMIT=99

# ---- 日志 ----
LOG_LEVEL=info
LOG_DIR=./logs

# ---- 限流 ----
THROTTLE_C_TTL=60
THROTTLE_C_LIMIT=100
THROTTLE_A_TTL=60
THROTTLE_A_LIMIT=200